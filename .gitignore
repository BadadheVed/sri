.env
*superpowers*
.claude
.vscode
.gemini

# Environments
.env.local
*.env

# Go
backend/bin/
backend/*.test
backend/coverage.out

# Python
ai/.venv/
ai/__pycache__/
ai/**/__pycache__/
ai/*.egg-info/
ai/.pytest_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Editors / OS
.idea/
.DS_Store

# kind / kubeconfig
kubeconfig*.yaml
*.kubeconfig

# Helm values files with real secrets in them — never commit these
helm/**/values.secret.yaml
helm/**/values.prod.yaml

# Helm dependency chart archives — build artifacts, not source. Chart.lock
# pins the exact version; `helm dependency build` refetches them from that.
helm/charts/*.tgz