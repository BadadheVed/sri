# Topology websocket endpoint (backend /ws/topology)
NEXT_PUBLIC_TOPOLOGY_WS_URL=ws://localhost:8080/ws/topology
# Dev-only auth token, appended as ?token=... (NEXT_PUBLIC_ values are exposed to the browser).
# Must equal the backend's TOPOLOGY_WS_TOKEN (helm: topologyWsToken) — NOT MCP_READONLY_TOKEN.
# The backend disables /ws/topology (404) when TOPOLOGY_WS_TOKEN is unset.
NEXT_PUBLIC_TOPOLOGY_TOKEN=dev-token
